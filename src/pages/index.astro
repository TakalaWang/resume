---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.svelte';
import { education, experience, profile, projects, recognition, stack } from '../data/resume';

const experienceMidpoint = Math.ceil(experience.length / 2);
const featuredProjects = projects.slice(0, 8);
const otherProjects = projects.slice(8);
---

<Layout title="Takala Wang — Engineer Resume">
  <div class="shell">
    <header class="nav">
      <a class="brand" href="#top"><span>●</span> 王重鈞 / TAKALA WANG</a>
      <nav class="nav-links" aria-label="主要導覽">
        <a href="#profile">履歷</a><a href="#work">作品</a><a href="#experience">經歷</a><a href="#contact">聯絡</a>
        <ThemeToggle client:load />
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-main"><p class="hero-kicker">{profile.title}</p><h1>{profile.chineseName}<span>{profile.englishName}</span></h1><p class="hero-thesis">Building useful systems.</p><p class="hero-lede">我把 AI 研究、產品工程與基礎設施整合成真正能被使用的系統。這裡整理我在開源、研究、工作與團隊合作中的實際貢獻。</p><div class="hero-actions"><a class="button primary" href="#work">看精選作品 ↓</a><a class="button" href={profile.email ? `mailto:${profile.email}` : '#contact'}>聯絡我 ↗</a></div></div>
        <div class="hero-art" aria-hidden="true"><b></b></div>
      </section>

      <section id="profile" class="section profile-section">
        <div class="section-head"><h2>個人資料</h2><p>履歷、聯絡方式與專業定位。</p></div>
        <div class="profile-grid">
          <div class="profile-intro"><p class="profile-name">{profile.chineseName}</p><p class="profile-english">{profile.englishName}</p><h3>{profile.title}</h3><p>軟體工程師與 AI 研究開發者，專注於把模型、產品與可靠的系統整合成真正可使用的工具。</p></div>
          <dl class="profile-facts"><div><dt>目前學歷</dt><dd>{education[0].title}<br />{education[0].school}</dd></div><div><dt>學士背景</dt><dd>{education[1].school}<br />Computer Science · Top 6%</dd></div><div><dt>主要方向</dt><dd>AI systems · Product engineering · Open source</dd></div></dl>
          <div class="profile-links"><h3>線上資料</h3><a href={`mailto:${profile.email}`}>Email ↗</a><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
        </div>
        <div class="credential-strip"><div><strong>M.S.</strong><span>NYCU · Computer Science</span></div><div><strong>B.S.</strong><span>NTNU · Computer Science</span></div><div><strong>SLaTE 2025</strong><span>Paper accepted</span></div><div><strong>ICPC</strong><span>Bronze · 2022, 2023</span></div></div>
      </section>

      <section id="work" class="section">
        <div class="section-head"><div><span class="section-index">01 / WORK</span><h2>精選作品</h2></div><p>不只展示成品，也說明我在其中負責什麼，以及它帶來的結果。</p></div>
        <div class="project-grid">
          {featuredProjects.map((project, index) => <article class={`project project-card ${index === 0 ? 'project-lead' : ''}`}><div class="project-top"><span>{String(index + 1).padStart(2, '0')} <em>{project.kind}</em></span><span>{project.result.includes('Live') ? 'LIVE' : 'CASE'}</span></div><h3>{project.title}</h3><p class="project-summary">{project.description}</p><div class="project-details"><div><span>我的貢獻</span><p>{project.contribution}</p></div><div><span>成果</span><p>{project.outcome}</p></div></div><div class="project-footer"><span>{project.stack}</span>{project.href && <a href={project.href} target="_blank" rel="noreferrer">查看專案 ↗</a>}</div></article>)}
        </div>
        <div class="more-projects">
          <div class="more-heading"><span class="section-index">OTHER WORK</span><p>研究與小型工具</p></div>
          {otherProjects.map((project) => <div class="more-project"><div><span>{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p></div>{project.href && <a href={project.href} target="_blank" rel="noreferrer">{project.result.includes('Live') || project.result.includes('demo') ? 'Demo' : 'GitHub'} ↗</a>}</div>)}
        </div>
      </section>

      <section id="experience" class="section">
        <div class="section-head"><div><span class="section-index">02 / EXPERIENCE</span><h2>經歷</h2></div><p>工作、研究與長期合作的工程經驗。</p></div>
        <div class="experience">
          <div class="experience-column">{experience.slice(0, experienceMidpoint).map((item) => <div class="experience-item"><time>{item.date}</time><h3>{item.link ? <a href={item.link} target="_blank" rel="noreferrer">{item.title} ↗</a> : item.title}</h3><p>{item.description}</p></div>)}</div>
          <div class="experience-column">{experience.slice(experienceMidpoint).map((item) => <div class="experience-item"><time>{item.date}</time><h3>{item.link ? <a href={item.link} target="_blank" rel="noreferrer">{item.title} ↗</a> : item.title}</h3><p>{item.description}</p></div>)}</div>
        </div>
      </section>

      <section id="about" class="section">
        <div class="about-grid"><h3>我喜歡把複雜的事情，<span>做得清楚。</span></h3><p>我會從問題本身開始，先理解使用者真正需要什麼，再把它拆成可驗證、可交付的工程工作。開源、產品和研究對我來說不是三條分開的路，而是不同形式的實作。過去的教學經驗，也讓我更習慣把複雜的技術說清楚。</p></div>
      </section>

      <section class="section resume-details">
        <div class="section-head"><div><span class="section-index">03 / RESUME</span><h2>履歷摘要</h2></div><p>學歷、技術棧與獎項。</p></div>
        <div class="resume-columns">
          <div><h3>學歷</h3>{education.map((item) => <div class="resume-item"><strong>{item.title}</strong><span>{item.date}</span><p>{item.school}</p></div>)}</div>
          <div><h3>技術棧</h3>{stack.map(([label, values]) => <div class="resume-item"><strong>{label}</strong><p>{values}</p></div>)}</div>
          <div><h3>獎項與發表</h3>{recognition.map(([label, value]) => <div class="resume-item"><strong>{label}</strong><p>{value}</p></div>)}</div>
        </div>
      </section>

      <section id="contact" class="section"><div class="cta"><h2>一起做點<br /><span>有用的事。</span></h2><a href="mailto:ccwangtakala@gmail.com">ccwangtakala@gmail.com ↗</a></div></section>
    </main>
    <footer><span>© 2026 Takala Wang</span><span><a href="https://github.com/TakalaWang" target="_blank" rel="noreferrer">GitHub</a> · <a href="https://www.linkedin.com/in/takalawang/" target="_blank" rel="noreferrer">LinkedIn</a> · <a href="https://takalawang.github.io/" target="_blank" rel="noreferrer">Blog</a></span></footer>
  </div>
</Layout>
