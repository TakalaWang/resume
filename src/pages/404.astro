---
import Base from '../layouts/Base.astro';
import { LinkButton } from '../components/site/Buttons';
import { withBase } from '../lib/view';
---
<Base locale="zh" path="/" title="404 · 王重鈞" description="找不到這個頁面 · Page not found">
  <main class="mx-auto flex min-h-svh max-w-3xl flex-col items-center justify-center px-6 text-center">
    <p class="reveal font-semibold text-accent text-xs uppercase tracking-[0.22em]">404</p>
    <h1 class="reveal mt-4 font-extrabold text-[clamp(2.4rem,6vw,4rem)] leading-tight tracking-tight" style="--i:1">找不到這個頁面</h1>
    <p class="reveal mt-3 text-lg text-muted-foreground" style="--i:1">This page doesn’t exist.</p>
    <div class="reveal mt-10 flex flex-wrap justify-center gap-3" style="--i:2">
      <LinkButton client:visible href={withBase('/')} label="回到首頁" />
      <LinkButton client:visible href={withBase('/en/')} label="English home" variant="outline" />
    </div>
  </main>
</Base>
