---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from './ThemeToggle';
import ProjectCard from './ProjectCard.astro';
import { education, experience, profile, projects, recognition, stack } from '../data/resume';
import { copy, experienceText, type Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredTitles = ['NOJV', 'OnStage TW', 'Speech Examination Platform', 'Hinagiku', 'Cool English'];
const featuredProjects = featuredTitles.map((title) => projects.find((project) => project.title === title)).filter((project): project is typeof projects[number] => Boolean(project));
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
const workPath = `${basePath}${lang === 'en' ? '/en/work/' : '/work/'}`;
const archiveLabel = lang === 'en' ? 'Open the complete work archive' : '開啟完整作品檔案';
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'Software Engineer' : '工程師履歷'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="observatory-shell">
    <header class="observatory-header">
      <a class="brand-mark" href={homePath}>{profile.chineseName} / {profile.displayName.toUpperCase()}</a>
      <nav class="header-nav" aria-label="Primary navigation">
        <a href="#work">{t.nav.work}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <div class="header-actions">
        <a class="language-switch" href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{t.nav.language}</a>
        <ThemeToggle client:load />
      </div>
    </header>

    <main>
      <section class="hero-stage" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 class="hero-title" id="hero-title">{profile.chineseName}<span>{profile.englishName}</span></h1>
          <p class="hero-role">{t.hero.role}</p>
          <div class="hero-meta" aria-label="Professional focus">
            <span>{lang === 'en' ? 'Product engineering' : '產品工程'}</span>
            <span>{lang === 'en' ? 'AI systems' : 'AI 系統'}</span>
            <span>{lang === 'en' ? 'Open source' : '開源協作'}</span>
          </div>
          <div class="hero-actions">
            <a class="signal-link" href="#work">{t.hero.work} <span aria-hidden="true">↓</span></a>
            <a class="signal-link muted" href={`mailto:${profile.email}`}>{profile.email}</a>
            <a class="signal-link muted" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="workbench-console" aria-label={lang === 'en' ? 'A layered work file for engineering projects' : '工程作品的分層工作檔案'}>
          <div class="document-stack" aria-hidden="true">
            <div class="document-sheet document-sheet-back"></div>
            <div class="document-sheet document-sheet-mid"></div>
            <div class="document-sheet document-sheet-front"><span>FILE / 001</span><strong>{lang === 'en' ? 'REAL WORK' : '實際作品'}<br />{lang === 'en' ? 'REAL SYSTEMS' : '真正系統'}</strong><small>TAKALA WANG<br />2026 / ENGINEERING</small></div>
          </div>
          <div class="workbench-readout"><strong>{lang === 'en' ? 'OPEN FILE' : '開啟檔案'}</strong>{lang === 'en' ? 'Products, research, open source' : '產品、研究、開源協作'}<br />{lang === 'en' ? 'Five selected records' : '五筆精選紀錄'}</div>
        </div>

        <p class="scroll-cue">{lang === 'en' ? 'Continue reading the field' : '繼續閱讀觀測紀錄'}</p>
      </section>

      <section class="section-block" id="profile" aria-labelledby="profile-title">
        <div class="section-heading">
          <h2 id="profile-title">{t.profile.title}</h2>
        </div>
        <div class="identity-grid">
          <div>
            <p class="identity-name">{profile.chineseName}<small>{profile.englishName}</small></p>
            <p class="identity-role">{profile.title}</p>
          </div>
          <dl class="fact-list">
            <div class="fact-row"><dt>{t.profile.current}</dt><dd>{education[0].title}<br />{education[0].school}</dd></div>
            <div class="fact-row"><dt>{t.profile.bachelor}</dt><dd>{education[1].school}<br />{t.profile.topSix}</dd></div>
            <div class="fact-row"><dt>{t.profile.focus}</dt><dd>AI systems · Product engineering · Open source</dd></div>
          </dl>
        </div>
      </section>

      <section class="section-block" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">{t.work.title}</h2>
        </div>
        <div class="project-track">
          {featuredProjects.map((project, index) => <ProjectCard project={project} lang={lang} index={index + 1} />)}
        </div>
        <a class="work-archive-link" href={workPath}><span>{archiveLabel}</span><span aria-hidden="true">↗</span></a>
      </section>

      <section class="section-block" id="experience" aria-labelledby="experience-title">
        <div class="section-heading">
          <h2 id="experience-title">{t.experience.title}</h2>
        </div>
        <div class="experience-log">
          {experience.map((item) => { const localized = experienceText(item, lang); return <article class="experience-entry"><time class="experience-date">{item.date}</time><div><h3>{item.link ? <a href={item.link} target="_blank" rel="noopener noreferrer">{localized.title} ↗</a> : localized.title}</h3><p>{localized.description}</p></div></article>; })}
        </div>
      </section>

      <section class="section-block" aria-labelledby="evidence-title">
        <div class="section-heading">
          <h2 id="evidence-title">{lang === 'en' ? 'Evidence' : '能力證據'}</h2>
        </div>
        <div class="evidence-grid">
          <div class="evidence-block"><h3>{lang === 'en' ? 'Toolbox' : '技術棧'}</h3>{stack.map(([label, values]) => <div class="stack-line"><strong>{label}</strong><span>{values}</span></div>)}</div>
          <div class="evidence-block"><h3>{lang === 'en' ? 'Recognition' : '獎項與成果'}</h3>{recognition.map(([label, value]) => <div class="recognition-line"><strong>{label}</strong><span>{value}</span></div>)}</div>
        </div>
      </section>

      <section class="section-block" id="contact" aria-labelledby="contact-title">
        <div class="contact-block">
          <div><h2 id="contact-title">{lang === 'en' ? 'Open a channel.' : '開啟聯絡。'}</h2></div>
          <div class="contact-channels"><a class="contact-channel" href={`mailto:${profile.email}`}>{profile.email}</a><a class="contact-channel" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
        </div>
      </section>
    </main>

    <footer class="observatory-footer"><span class="footer-meta">© 2026 {profile.displayName} · {t.footer.note}</span><span class="footer-links"><a href={profile.website} target="_blank" rel="noopener noreferrer">{t.footer.blog}</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></span></footer>
  </div>
</Layout>
