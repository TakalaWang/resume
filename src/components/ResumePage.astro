---
import Layout from '../layouts/Layout.astro';
import SmoothWorkList from './SmoothWorkList';
import ThemeToggle from './ThemeToggle';
import SmoothButton from './ui/smoothui/smooth-button';
import { education, experience, profile, recognition, stack } from '../data/resume';
import { copy, experienceText, type Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
const workPath = `${basePath}${lang === 'en' ? '/en/work/' : '/work/'}`;
const currentRole = experience[0];
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'Software Engineer' : '工程師履歷'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="smooth-site">
    <header class="smooth-header">
      <a class="smooth-brand" href={homePath} aria-label={`${profile.chineseName} / ${profile.displayName}`}><span class="smooth-brand-mark">TW</span><span>{profile.chineseName}<small>{profile.displayName}</small></span></a>
      <nav class="smooth-nav" aria-label="Primary navigation"><a href="#work">{t.nav.work}</a><a href="#experience">{t.nav.experience}</a><a href="#contact">{t.nav.contact}</a></nav>
      <div class="smooth-header-actions"><a href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{t.nav.language}</a><ThemeToggle client:load /></div>
    </header>

    <main>
      <section class="smooth-hero" aria-labelledby="hero-title">
        <div class="smooth-hero-copy">
          <h1 id="hero-title">{profile.chineseName}<span>{profile.englishName}</span></h1>
          <p class="smooth-role">{profile.title}</p>
          <p class="smooth-hero-summary">{lang === 'en' ? 'I build software products, AI systems, and open-source tools that people can use.' : '我做軟體產品、AI 系統與真正有人使用的開源工具。'}</p>
          <div class="smooth-hero-actions"><a href="#work" class="smooth-text-link">{t.hero.work}<svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a><a href={`mailto:${profile.email}`} class="smooth-text-link">{profile.email}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="smooth-text-link">LinkedIn <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></div>
        </div>
        <aside class="smooth-profile-panel" aria-label={lang === 'en' ? 'Current profile' : '目前個人資料'}>
          <div class="smooth-panel-head"><span>{lang === 'en' ? 'CURRENTLY' : '目前狀態'}</span><span class="smooth-available"><i /> {lang === 'en' ? 'Available' : '可聯絡'}</span></div>
          <div class="smooth-panel-role"><span>{lang === 'en' ? 'Working as' : '目前職務'}</span><strong>{currentRole.title.split(' · ')[0]}</strong><a href={currentRole.link} target="_blank" rel="noopener noreferrer">{currentRole.title.split(' · ')[1]} <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></div>
          <dl class="smooth-panel-facts"><div><dt>{lang === 'en' ? 'Location' : '所在地'}</dt><dd>{profile.location}</dd></div><div><dt>{lang === 'en' ? 'Focus' : '方向'}</dt><dd>AI · Product · OSS</dd></div></dl>
          <a class="smooth-panel-email" href={`mailto:${profile.email}`}>{profile.email}<svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a>
        </aside>
      </section>

      <section class="smooth-proof-strip" aria-label={lang === 'en' ? 'Education and recognition' : '學歷與成果'}>
        <div><span>{lang === 'en' ? 'Education' : '學歷'}</span><strong>{education[0].title}</strong><small>{education[0].school}</small></div>
        <div><span>{lang === 'en' ? 'Before' : '學士'}</span><strong>{education[1].title}</strong><small>{education[1].school}</small></div>
        <div><span>{lang === 'en' ? 'Recognition' : '成果'}</span><strong>SLaTE · ICPC · 客語競賽</strong><small>{lang === 'en' ? 'Research and competition work' : '研究與競賽成果'}</small></div>
      </section>

      <section class="smooth-section smooth-work-section" id="work" aria-labelledby="work-title">
        <div class="smooth-section-heading"><div><h2 id="work-title">{lang === 'en' ? 'Work I helped ship.' : '我參與完成的作品。'}</h2></div><a class="smooth-inline-action" href={workPath}>{t.work.more}<svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></div>
        <SmoothWorkList client:load lang={lang} featured />
      </section>

      <section class="smooth-section smooth-experience-section" id="experience" aria-labelledby="experience-title">
        <div class="smooth-section-heading"><div><h2 id="experience-title">{lang === 'en' ? 'A practical timeline.' : '工程與研究經歷。'}</h2></div></div>
        <div class="smooth-timeline">{experience.map((item, index) => { const localized = experienceText(item, lang); return <article class="smooth-timeline-row"><time>{item.date}</time><div><h3>{item.link ? <a href={item.link} target="_blank" rel="noopener noreferrer">{localized.title}<svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a> : localized.title}</h3><p>{localized.description}</p></div><span>{String(index + 1).padStart(2, '0')}</span></article>; })}</div>
      </section>

      <section class="smooth-section smooth-proof-section" aria-labelledby="proof-title">
        <div class="smooth-section-heading"><div><h2 id="proof-title">{lang === 'en' ? 'Tools I work with.' : '我用來完成工作的工具。'}</h2></div></div>
        <div class="smooth-capability-layout"><div class="smooth-stack-list">{stack.map(([label, values]) => <div><span>{label}</span><strong>{values}</strong></div>)}</div><div class="smooth-awards"><h3>{lang === 'en' ? 'Awards & papers' : '獎項與論文'}</h3>{recognition.map(([label, value]) => <div><strong>{label}</strong><span>{value}</span></div>)}</div></div>
      </section>

      <section class="smooth-contact" id="contact" aria-labelledby="contact-title"><div><h2 id="contact-title">{lang === 'en' ? 'Let’s work together.' : '一起做點有用的東西。'}</h2><p>{lang === 'en' ? 'Email is the fastest way to reach me.' : 'Email 是最快找到我的方式。'}</p></div><div class="smooth-contact-links"><SmoothButton asChild variant="solid" color="blue" size="lg"><a href={`mailto:${profile.email}`}>{profile.email}<svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></SmoothButton><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></div></section>
    </main>

    <footer class="smooth-footer"><span>© 2026 {profile.displayName}</span><a href={profile.website} target="_blank" rel="noopener noreferrer">{t.footer.blog} <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></footer>
  </div>
</Layout>
