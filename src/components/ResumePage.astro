---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from './ProjectShowcase';
import ThemeToggle from './ThemeToggle';
import { education, experience, profile, recognition, stack } from '../data/resume';
import { copy, experienceText, type Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
const workPath = `${basePath}${lang === 'en' ? '/en/work/' : '/work/'}`;
const currentRole = experience[0];
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'Software Engineer' : '工程師履歷'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="resume-shell">
    <header class="site-header">
      <a class="site-brand" href={homePath}><span class="brand-dot" aria-hidden="true"></span>{profile.chineseName}<span class="brand-slash">/</span>{profile.displayName}</a>
      <nav class="site-nav" aria-label="Primary navigation"><a href="#work">{t.nav.work}</a><a href="#experience">{t.nav.experience}</a><a href="#contact">{t.nav.contact}</a></nav>
      <div class="site-actions"><a href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{t.nav.language}</a><ThemeToggle client:load /></div>
    </header>

    <main>
      <section class="intro-section" aria-labelledby="intro-title">
        <div class="intro-copy">
          <p class="section-label">{profile.title}</p>
          <h1 id="intro-title">{profile.chineseName}<span>{profile.englishName}</span></h1>
          <p class="intro-role">{lang === 'en' ? 'I build product systems, AI tools, and open-source software.' : '我把產品系統、AI 工具與開源軟體做成真正能運作的東西。'}</p>
          <div class="intro-links"><a class="primary-link" href="#work">{t.hero.work}<span aria-hidden="true">↘</span></a><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="status-panel" aria-label={lang === 'en' ? 'Current status' : '目前狀態'}>
          <div class="status-panel-header"><span>{lang === 'en' ? 'CURRENT STATUS' : '目前狀態'}</span><span class="status-live"><i /> {lang === 'en' ? 'Available' : '可聯絡'}</span></div>
          <div class="status-role"><span>{lang === 'en' ? 'Working as' : '目前職務'}</span><strong>{currentRole.title.split(' · ')[0]}</strong><a href={currentRole.link} target="_blank" rel="noopener noreferrer">{currentRole.title.split(' · ')[1]} <span aria-hidden="true">↗</span></a></div>
          <div class="status-route" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <dl class="status-facts"><div><dt>{lang === 'en' ? 'Based in' : '所在地'}</dt><dd>{profile.location}</dd></div><div><dt>{lang === 'en' ? 'Focus' : '方向'}</dt><dd>AI · Product · OSS</dd></div></dl>
        </div>
      </section>

      <section class="facts-strip scroll-reveal" aria-label={lang === 'en' ? 'Profile facts' : '個人資料摘要'}>
        <div><span>{t.profile.current}</span><strong>{education[0].title}</strong><small>{education[0].school}</small></div>
        <div><span>{t.profile.bachelor}</span><strong>{education[1].title}</strong><small>{education[1].school}</small></div>
        <div><span>{lang === 'en' ? 'Recognition' : '成果'}</span><strong>SLaTE · ICPC · 客語競賽</strong><small>{lang === 'en' ? 'Research and competition work' : '研究與競賽成果'}</small></div>
      </section>

      <section class="content-section work-section scroll-reveal" id="work" aria-labelledby="work-title">
        <div class="section-heading"><div><span class="section-label">01 / {lang === 'en' ? 'Selected work' : '精選作品'}</span><h2 id="work-title">{t.work.title}</h2></div><a class="section-action" href={workPath}>{lang === 'en' ? 'View all work' : '查看全部作品'} <span aria-hidden="true">↗</span></a></div>
        <ProjectShowcase client:load lang={lang} featured />
      </section>

      <section class="content-section experience-section scroll-reveal" id="experience" aria-labelledby="experience-title">
        <div class="section-heading"><div><span class="section-label">02 / {lang === 'en' ? 'Timeline' : '工作與研究'}</span><h2 id="experience-title">{t.experience.title}</h2></div></div>
        <div class="experience-list">{experience.map((item, index) => { const localized = experienceText(item, lang); return <article class="experience-row"><time>{item.date}</time><div><h3>{item.link ? <a href={item.link} target="_blank" rel="noopener noreferrer">{localized.title}<span aria-hidden="true">↗</span></a> : localized.title}</h3><p>{localized.description}</p></div><span class="experience-number">{String(index + 1).padStart(2, '0')}</span></article>; })}</div>
      </section>

      <section class="content-section proof-section scroll-reveal" aria-labelledby="proof-title">
        <div class="section-heading"><div><span class="section-label">03 / {lang === 'en' ? 'Proof' : '能力證據'}</span><h2 id="proof-title">{lang === 'en' ? 'What I work with' : '我使用的工具'}</h2></div></div>
        <div class="proof-layout"><div class="stack-table">{stack.map(([label, values]) => <div><span>{label}</span><strong>{values}</strong></div>)}</div><div class="recognition-list"><h3>{lang === 'en' ? 'Recognition' : '獎項與成果'}</h3>{recognition.map(([label, value]) => <div><strong>{label}</strong><span>{value}</span></div>)}</div></div>
      </section>

      <section class="contact-section scroll-reveal" id="contact" aria-labelledby="contact-title"><div><span class="section-label">04 / {lang === 'en' ? 'Contact' : '聯絡'}</span><h2 id="contact-title">{lang === 'en' ? 'Let’s build something useful.' : '一起做點真正有用的東西。'}</h2></div><div class="contact-links"><a class="primary-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></section>
    </main>

    <footer class="site-footer"><span>© 2026 {profile.displayName}</span><a href={profile.website} target="_blank" rel="noopener noreferrer">{t.footer.blog} <span aria-hidden="true">↗</span></a></footer>
  </div>
</Layout>
