---
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import SmoothButton from './ui/smoothui/smooth-button';
import ThemeToggle from './ThemeToggle';
import { education, experience, profile, projects, recognition, stack } from '../data/resume';
import { copy, experienceText, type Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const featuredTitles = ['NOJV', 'OnStage TW', 'Speech Examination Platform', 'Hinagiku', 'Cool English'];
const featuredProjects = featuredTitles.map((title) => projects.find((project) => project.title === title)).filter((project): project is typeof projects[number] => Boolean(project));
const midpoint = Math.ceil(experience.length / 2);
const homePath = lang === 'en' ? '/en/' : '/';
const workPath = lang === 'en' ? '/en/work/' : '/work/';
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'Software Engineer' : '工程師履歷'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <header class="flex items-center justify-between border-b border-border py-5">
      <a class="text-sm font-semibold tracking-tight text-foreground" href={homePath}><span class="mr-2 text-primary">●</span>{profile.chineseName} / {profile.displayName.toUpperCase()}</a>
      <nav class="flex items-center gap-2 sm:gap-5" aria-label="Primary navigation">
        <a class="hidden text-sm text-muted-foreground transition hover:text-foreground sm:inline" href="#work">{t.nav.work}</a>
        <a class="hidden text-sm text-muted-foreground transition hover:text-foreground sm:inline" href="#experience">{t.nav.experience}</a>
        <a class="hidden text-sm text-muted-foreground transition hover:text-foreground sm:inline" href="#contact">{t.nav.contact}</a>
        <a class="rounded-full px-2.5 py-1 text-xs font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground" href={lang === 'en' ? '/' : '/en/'}>{t.nav.language}</a>
        <ThemeToggle client:load />
      </nav>
    </header>

    <main>
      <section class="relative flex min-h-[620px] items-center overflow-hidden py-24 sm:py-32">
        <div class="relative z-10 max-w-3xl">
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-primary">{t.hero.role}</p>
          <h1 class="text-[clamp(4.5rem,14vw,10rem)] font-semibold leading-[0.82] tracking-[-0.1em] text-foreground">{profile.chineseName}<span class="mt-6 block text-[clamp(1rem,2.2vw,1.75rem)] font-medium tracking-[0.08em] text-primary">{profile.englishName.toUpperCase()}</span></h1>
          <p class="mt-8 text-2xl font-semibold tracking-tight text-foreground sm:text-4xl">{t.hero.thesis}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <SmoothButton client:load asChild size="lg" variant="default"><a href="#work">{t.hero.work} <span aria-hidden="true">↓</span></a></SmoothButton>
            <SmoothButton client:load asChild size="lg" variant="outline"><a href={`mailto:${profile.email}`}>{profile.email}</a></SmoothButton>
            <a class="px-2 text-sm font-medium text-muted-foreground underline decoration-border underline-offset-4 transition hover:text-foreground" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>
        <div class="pointer-events-none absolute -right-24 top-1/2 size-72 -translate-y-1/2 rounded-full border border-primary/20 opacity-50 sm:-right-10" aria-hidden="true"><div class="absolute inset-7 rounded-full border border-primary/15"></div><div class="absolute inset-20 rounded-full bg-primary/30 blur-2xl"></div></div>
      </section>

      <section id="profile" class="border-t border-border py-20 sm:py-24">
        <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{t.profile.eyebrow}</p><h2 class="mt-3 text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">{t.profile.title}</h2></div><p class="max-w-xs text-sm leading-6 text-muted-foreground">{t.profile.summary}</p></div>
        <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
          <div><p class="text-5xl font-semibold tracking-[-0.08em] text-primary">{profile.chineseName}</p><p class="mt-2 text-muted-foreground">{profile.englishName}</p><p class="mt-8 max-w-md text-lg leading-8 text-foreground">{profile.title}</p></div>
          <dl class="grid gap-5 sm:grid-cols-3 lg:grid-cols-1">
            <div class="border-b border-border pb-4"><dt class="text-xs text-muted-foreground">{t.profile.current}</dt><dd class="mt-2 font-medium text-foreground">{education[0].title}<br />{education[0].school}</dd></div>
            <div class="border-b border-border pb-4"><dt class="text-xs text-muted-foreground">{t.profile.bachelor}</dt><dd class="mt-2 font-medium text-foreground">{education[1].school}<br />{t.profile.topSix}</dd></div>
            <div class="border-b border-border pb-4"><dt class="text-xs text-muted-foreground">{t.profile.focus}</dt><dd class="mt-2 font-medium text-foreground">AI systems · Product engineering · Open source</dd></div>
          </dl>
        </div>
      </section>

      <section id="work" class="border-t border-border py-20 sm:py-24">
        <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{t.work.eyebrow}</p><h2 class="mt-3 text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">{t.work.title}</h2></div><p class="max-w-xs text-sm leading-6 text-muted-foreground">{t.work.summary}</p></div>
        <div class="grid gap-6 lg:grid-cols-2">{featuredProjects.map((project, index) => <ProjectCard project={project} lang={lang} index={index + 1} />)}</div>
        <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-2xl border border-border bg-muted/40 p-6 sm:flex-row sm:items-center"><div><p class="font-medium text-foreground">{t.work.moreHint}</p><p class="mt-1 text-sm text-muted-foreground">{projects.length} projects · research · open source</p></div><SmoothButton client:visible asChild size="lg" variant="outline"><a href={workPath}>{t.work.more} <span aria-hidden="true">↗</span></a></SmoothButton></div>
      </section>

      <section id="experience" class="border-t border-border py-20 sm:py-24">
        <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{t.experience.eyebrow}</p><h2 class="mt-3 text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">{t.experience.title}</h2></div><p class="max-w-xs text-sm leading-6 text-muted-foreground">{t.experience.summary}</p></div>
        <div class="grid gap-x-12 lg:grid-cols-2">
          {[experience.slice(0, midpoint), experience.slice(midpoint)].map((column) => <div class="border-t border-border">{column.map((item) => { const localized = experienceText(item, lang); return <article class="border-b border-border py-5"><time class="text-xs text-primary">{item.date}</time><h3 class="mt-1 text-lg font-semibold text-foreground">{item.link ? <a class="transition hover:text-primary" href={item.link} target="_blank" rel="noreferrer">{localized.title} ↗</a> : localized.title}</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">{localized.description}</p></article>; })}</div>)}
        </div>
      </section>

      <section class="border-t border-border py-20 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-2">
          <div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">TOOLBOX</p><h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground">Stack I use to ship.</h2>{stack.map(([label, values]) => <div class="mt-6 border-b border-border pb-4"><p class="text-xs text-muted-foreground">{label}</p><p class="mt-2 text-sm leading-6 text-foreground">{values}</p></div>)}</div>
          <div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">RECOGNITION</p><h2 class="mt-3 text-3xl font-semibold tracking-tight text-foreground">Selected signals.</h2>{recognition.map(([label, value]) => <div class="flex justify-between gap-5 border-b border-border py-5 text-sm"><strong class="font-medium text-foreground">{label}</strong><span class="text-right text-muted-foreground">{value}</span></div>)}</div>
        </div>
      </section>

      <section id="contact" class="border-t border-border py-20 sm:py-24"><div class="flex flex-col justify-between gap-8 rounded-2xl border border-border bg-muted/40 p-7 sm:flex-row sm:items-end sm:p-10"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">CONTACT</p><h2 class="mt-4 max-w-xl text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">Let’s build something useful.</h2></div><div class="flex flex-col items-start gap-3 text-sm"><a class="font-medium text-foreground underline decoration-border underline-offset-4 hover:text-primary" href={`mailto:${profile.email}`}>{profile.email} ↗</a><a class="font-medium text-foreground underline decoration-border underline-offset-4 hover:text-primary" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div></section>
    </main>

    <footer class="flex flex-col justify-between gap-4 border-t border-border py-8 text-xs text-muted-foreground sm:flex-row"><span>© 2026 {profile.displayName} · {t.footer.note}</span><span><a class="hover:text-foreground" href={profile.website} target="_blank" rel="noreferrer">{t.footer.blog}</a> · <a class="hover:text-foreground" href="https://github.com/TakalaWang" target="_blank" rel="noreferrer">GitHub</a></span></footer>
  </div>
</Layout>
