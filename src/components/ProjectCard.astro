---
import { projectMedia } from '../data/projectMedia';
import { projectText, type Lang } from '../data/siteCopy';
import type { projects } from '../data/resume';

type Project = (typeof projects)[number];
interface Props { project: Project; lang: Lang; index: number; }

const { project, lang, index } = Astro.props;
const text = projectText(project, lang);
const media = projectMedia[project.title];
const labels = lang === 'en'
  ? { contribution: 'Contribution', outcome: 'Outcome', open: 'Open signal' }
  : { contribution: '我的貢獻', outcome: '成果', open: '開啟專案' };
---

<article class="project-entry" id={`project-${project.title.toLowerCase().replaceAll(' ', '-')}`}>
  <div class="project-beacon" aria-hidden="true">
    <span class="project-index">{String(index).padStart(2, '0')}</span>
    <p class="project-kind">{project.kind}</p>
    <p class="project-stack">{project.stack}</p>
  </div>

  <div class="project-main">
    {media ? (
      <div class="project-media-frame">
        {project.href ? <a href={project.href} target="_blank" rel="noreferrer" aria-label={`${labels.open}: ${project.title}`}><img src={media} alt={`${project.title} project preview`} loading={index > 1 ? 'lazy' : 'eager'} /></a> : <img src={media} alt={`${project.title} project preview`} loading={index > 1 ? 'lazy' : 'eager'} />}
      </div>
    ) : (
      <div class="project-abstract" aria-label={`${project.title} case study visual`}>
        <span class="abstract-stamp" aria-hidden="true"></span>
        <span class="abstract-title">{project.title}</span>
      </div>
    )}

    <div class="project-copy">
      <h3>{project.title}</h3>
      <p class="project-description">{text.description}</p>
      <div class="project-proof">
        <div class="proof-row"><strong>{labels.contribution}</strong><span>{text.contribution}</span></div>
        <div class="proof-row"><strong>{labels.outcome}</strong><span>{text.outcome}</span></div>
      </div>
      {project.href && <a class="project-link" href={project.href} target="_blank" rel="noreferrer">{labels.open} <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
