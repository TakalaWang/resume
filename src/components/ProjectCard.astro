---
import SmoothButton from './ui/smoothui/smooth-button';
import { projectMedia } from '../data/projectMedia';
import { projectText, type Lang } from '../data/siteCopy';
import type { projects } from '../data/resume';

type Project = (typeof projects)[number];
interface Props { project: Project; lang: Lang; index: number; }

const { project, lang, index } = Astro.props;
const text = projectText(project, lang);
const media = projectMedia[project.title];
const labels = lang === 'en'
  ? { live: 'LIVE', case: 'CASE', contribution: 'My contribution', outcome: 'Outcome', open: 'Open project' }
  : { live: 'LIVE', case: 'CASE', contribution: '我的貢獻', outcome: '成果', open: '開啟專案' };
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10">
  {media ? (
    <a class="relative block aspect-[16/9] overflow-hidden bg-muted" href={project.href} target="_blank" rel="noreferrer" aria-label={`${labels.open}: ${project.title}`}>
      <img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={media} alt={`${project.title} preview`} loading={index > 1 ? 'lazy' : 'eager'} />
      <span class="absolute left-4 top-4 rounded-full bg-background/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-foreground backdrop-blur">{project.result.includes('Live') ? labels.live : labels.case}</span>
    </a>
  ) : (
    <div class="flex aspect-[16/9] items-end bg-gradient-to-br from-muted via-card to-background p-5">
      <div><p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">{project.kind}</p><p class="text-2xl font-semibold tracking-tight text-foreground">{project.title}</p></div>
    </div>
  )}
  <div class="flex flex-1 flex-col gap-5 p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div><p class="text-xs font-medium text-muted-foreground">{String(index).padStart(2, '0')} · {project.kind}</p><h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">{project.title}</h3></div>
      <span class="rounded-full border border-border px-2.5 py-1 text-[10px] font-medium text-muted-foreground">{project.result.includes('Live') ? labels.live : labels.case}</span>
    </div>
    <p class="text-sm leading-6 text-muted-foreground">{text.description}</p>
    <div class="grid gap-4 border-t border-border pt-4 text-sm sm:grid-cols-2">
      <div><p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">{labels.contribution}</p><p class="mt-1 leading-6 text-foreground/80">{text.contribution}</p></div>
      <div><p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">{labels.outcome}</p><p class="mt-1 leading-6 text-foreground/80">{text.outcome}</p></div>
    </div>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-2">
      <p class="text-xs text-muted-foreground">{project.stack}</p>
      {project.href && <SmoothButton client:visible asChild size="sm" variant="outline"><a href={project.href} target="_blank" rel="noreferrer">{labels.open} <span aria-hidden="true">↗</span></a></SmoothButton>}
    </div>
  </div>
</article>
