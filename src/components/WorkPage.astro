---
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import ThemeToggle from './ThemeToggle';
import { profile, projects } from '../data/resume';
import { copy, type Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const homePath = lang === 'en' ? '/en/' : '/';
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'All Work' : '所有作品'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <header class="flex items-center justify-between border-b border-border py-5">
      <a class="text-sm font-semibold tracking-tight text-foreground" href={homePath}><span class="mr-2 text-primary">●</span>{profile.chineseName} / {profile.displayName.toUpperCase()}</a>
      <nav class="flex items-center gap-2"><a class="rounded-full px-3 py-1.5 text-sm text-muted-foreground transition hover:bg-muted hover:text-foreground" href={homePath}>{lang === 'en' ? 'Back home' : '回到首頁'}</a><a class="rounded-full px-2.5 py-1 text-xs font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground" href={lang === 'en' ? '/' : '/en/'}>{lang === 'en' ? '中文' : 'EN'}</a><ThemeToggle client:load /></nav>
    </header>
    <main>
      <section class="py-20 sm:py-28"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">{t.work.eyebrow}</p><h1 class="mt-4 text-5xl font-semibold tracking-[-0.06em] text-foreground sm:text-8xl">{lang === 'en' ? 'All work.' : '所有作品。'}</h1><p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground">{lang === 'en' ? 'A complete record of products, research systems, collaborations, and open-source tools.' : '完整整理產品、研究系統、合作專案與開源工具。'}</p></section>
      <section class="grid gap-6 border-t border-border py-12 lg:grid-cols-2">{projects.map((project, index) => <ProjectCard project={project} lang={lang} index={index + 1} />)}</section>
    </main>
    <footer class="flex flex-col justify-between gap-4 border-t border-border py-8 text-xs text-muted-foreground sm:flex-row"><span>© 2026 {profile.displayName}</span><a class="hover:text-foreground" href={`mailto:${profile.email}`}>{profile.email}</a></footer>
  </div>
</Layout>
