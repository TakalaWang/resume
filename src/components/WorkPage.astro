---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from './ProjectShowcase';
import ThemeToggle from './ThemeToggle';
import { profile } from '../data/resume';
import type { Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'All Work' : '所有作品'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="resume-shell archive-shell">
    <header class="site-header"><a class="site-brand" href={homePath}><span class="brand-dot" aria-hidden="true"></span>{profile.chineseName}<span class="brand-slash">/</span>{profile.displayName}</a><nav class="site-nav" aria-label="Archive navigation"><a href={homePath}>{lang === 'en' ? 'Back home' : '回到首頁'}</a></nav><div class="site-actions"><a href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{lang === 'en' ? '中文' : 'EN'}</a><ThemeToggle client:load /></div></header>
    <main>
      <section class="archive-intro"><span class="section-label">{lang === 'en' ? 'Complete work index' : '完整作品索引'}</span><h1>{lang === 'en' ? 'All work' : '所有作品'}</h1><p>{lang === 'en' ? 'Select a project to inspect the shipped surface, contribution, and result.' : '選擇一個作品，查看實際頁面、我的貢獻與成果。'}</p></section>
      <section class="archive-showcase scroll-reveal" aria-label={lang === 'en' ? 'All projects' : '所有專案'}><ProjectShowcase client:load lang={lang} /></section>
    </main>
    <footer class="site-footer"><span>© 2026 {profile.displayName}</span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></footer>
  </div>
</Layout>
