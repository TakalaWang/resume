---
import Layout from '../layouts/Layout.astro';
import SmoothWorkList from './SmoothWorkList';
import ThemeToggle from './ThemeToggle';
import { profile } from '../data/resume';
import type { Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'All Work' : '所有作品'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="smooth-site smooth-archive">
    <header class="smooth-header">
      <a class="smooth-brand" href={homePath} aria-label={`${profile.chineseName} / ${profile.displayName}`}><span class="smooth-brand-mark">TW</span><span>{profile.chineseName}<small>{profile.displayName}</small></span></a>
      <nav class="smooth-nav" aria-label="Archive navigation"><a href={homePath}>{lang === 'en' ? 'Back home' : '回到首頁'}</a></nav>
      <div class="smooth-header-actions"><a href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{lang === 'en' ? '中文' : 'EN'}</a><ThemeToggle client:load /></div>
    </header>
    <main>
      <section class="smooth-archive-heading"><h1>{lang === 'en' ? 'All work.' : '所有作品。'}</h1><p>{lang === 'en' ? 'Products, open-source work, research, and collaborations.' : '產品、開源、研究與合作作品。'}</p></section>
      <section class="smooth-archive-content"><SmoothWorkList client:load lang={lang} /></section>
    </main>
    <footer class="smooth-footer"><span>© 2026 {profile.displayName}</span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <svg class="smooth-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a></footer>
  </div>
</Layout>
