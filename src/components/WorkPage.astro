---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from './ThemeToggle';
import ProjectBrowser from './ProjectBrowser';
import { profile } from '../data/resume';
import type { Lang } from '../data/siteCopy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = `${basePath}${lang === 'en' ? '/en/' : '/'}`;
---

<Layout title={`${profile.displayName} — ${lang === 'en' ? 'All Work' : '所有作品'}`} lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <div class="observatory-shell">
    <header class="observatory-header">
      <a class="brand-mark" href={homePath}>{profile.chineseName} / {profile.displayName.toUpperCase()}</a>
      <nav class="header-nav" aria-label="Archive navigation"><a href={homePath}>{lang === 'en' ? 'Back home' : '回到首頁'}</a></nav>
      <div class="header-actions"><a class="language-switch" href={`${basePath}${lang === 'en' ? '/' : '/en/'}`}>{lang === 'en' ? '中文' : 'EN'}</a><ThemeToggle client:load /></div>
    </header>

    <main>
      <section class="archive-heading" aria-labelledby="archive-title">
        <h1 id="archive-title">{lang === 'en' ? 'All work.' : '所有作品。'}</h1>
      </section>
      <section class="archive-list" aria-label={lang === 'en' ? 'All projects' : '所有專案'}>
        <ProjectBrowser client:load lang={lang} />
      </section>
    </main>

    <footer class="observatory-footer"><span class="footer-meta">© 2026 {profile.displayName}</span><span class="footer-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></span></footer>
  </div>
</Layout>
